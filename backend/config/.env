# ==============================================================================
# Play-On Mombasa Booking System Configuration
# ==============================================================================

# Database Connection (cPanel MySQL credentials)
DB_HOST=localhost
DB_NAME=mombasaM_booking
DB_USER=mombasaM_admin
DB_PASS=playon@4000
DB_CHARSET=utf8mb4

# CORS & Allowed Frontend Domains (comma-separated)
ALLOWED_ORIGINS=https://shimix-del.github.io,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080
FRONTEND_URL=https://shimix-del.github.io/playon

# SMTP Email Settings (PHPMailer for cPanel Webmail)
# Replace SMTP_PASS with your actual cPanel email account password for info@mombasamall.co.ke
SMTP_ENABLED=true
SMTP_HOST=mail.mombasamall.co.ke
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_AUTH=true
SMTP_USER=info@mombasamall.co.ke
SMTP_PASS=YourEmailPasswordHere
SMTP_FROM_EMAIL=info@mombasamall.co.ke
SMTP_FROM_NAME=Play-On Mombasa

# Admin Notification Recipients (comma-separated)
ADMIN_EMAILS=playonkenya@gmail.com,mombasamall01@gmail.com

# Admin Security & Sessions
SESSION_NAME=PLAYON_ADMIN_SESS
SESSION_LIFETIME=7200
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
